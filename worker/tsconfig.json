{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023"],
    "types": ["@cloudflare/workers-types"],
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    // satori ships declarations that reference React and Node Buffer types,

    // neither of which a Worker has. Matches the client tsconfig, which has

    // carried this since the start.

    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["./**/*.ts", "../src/game/scoring.ts", "../src/game/types.ts", "../src/game/moderation.ts"]
}
